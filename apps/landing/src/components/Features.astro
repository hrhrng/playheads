---
const features = [
  {
    title: 'Converse',
    description: 'Describe a mood, a memory, a moment. Your AI DJ translates intent into music — no browsing, no searching.',
  },
  {
    title: 'Listen',
    description: 'Songs play directly through Apple Music. Your DJ curates, you experience.',
  },
  {
    title: 'Yours',
    description: 'Taste evolves with every session. Conversations stay private, context carries forward.',
  },
];
---

<section id="features" class="scroll-mt-16 px-6 py-16 md:py-20 max-w-3xl mx-auto">
  <div class="border-t border-night-700 pt-12 space-y-10">
    {features.map((feature, i) => (
      <div class="flex items-baseline gap-6">
        <span class="text-night-600 font-mono text-xs tabular-nums shrink-0">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h3 class="text-xl font-display font-semibold text-night-50 tracking-tight mb-2">{feature.title}</h3>
          <p class="text-night-300 text-sm leading-relaxed max-w-md">{feature.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
