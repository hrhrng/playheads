---
import WaitlistForm from './WaitlistForm.tsx';
---

<section id="waitlist" class="scroll-mt-16 px-6 py-20 md:py-28 bg-night-900">
  <div class="max-w-lg mx-auto text-center">
    <p class="text-night-400 text-xs font-mono uppercase tracking-[0.25em] mb-3">Early Access</p>
    <h2 class="text-3xl sm:text-4xl font-display font-bold text-night-50 mb-4">
      Join the Misfits.
    </h2>
    <p class="text-night-300 text-sm leading-relaxed mb-8 max-w-md mx-auto">
      We're letting people in slowly. Drop your email and we'll reach out when it's your turn.
    </p>
    <WaitlistForm client:load />
  </div>
</section>
