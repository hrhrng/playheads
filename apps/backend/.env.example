# LLM Provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-...
ANTHROPIC_BASE_URL=https://api.openai-proxy.org/anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
# Extended thinking budget (0 = disabled, e.g. 1024, 4096)
ANTHROPIC_THINKING_BUDGET=0

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=...
# Minimax TTS
MINIMAX_API_KEY=...
MINIMAX_API_URL=https://api.minimax.chat/v1/t2a_v2
#
DATABASE_URL=...
#
# Apple Music
APPLE_MUSIC_TEAM_ID=...
APPLE_MUSIC_KEY_ID=...
APPLE_MUSIC_PRIVATE_KEY_PATH=...
# Or inline PEM string with \n
APPLE_MUSIC_PRIVATE_KEY=...
APPLE_MUSIC_TOKEN_TTL_SECONDS=3600
